{
  "$schema": "https://beepboop.kjanat.dev/schema/v1.json",
  "managers": ["github-release", "workflow"],
  "streams": {
    "main": {
      "versionSource": {
        "kind": "tags",
        "prefix": "v"
      },
      "prepare": {
        "version": "manual"
      },
      "workflows": {
        "release": {
          "file": "release.yml",
          "mode": "observe",
          "ref": "refs/tags/v*"
        },
        "retry": {
          "file": "release.yml",
          "mode": "observe",
          "required": false
        }
      }
    }
  }
}
