{
  "$schema": "https://beepboop.kjanat.dev/schema/v1.json",
  "managers": ["github-release", "workflow"],
  "streams": {
    "main": {
      "versionSource": {
        "kind": "tags",
        "prefix": "v"
      },
      "prepare": {
        "version": "manual"
      },
      "packages": [],
      "versioning": "workspace",
      "required": [],
      "promote": {
        "approval": "required",
        "workflow": {
          "file": "publish.yml",
          "ref": "master",
          "publications": ["github-release:kjanat/gpg-signing-service"],
          "refs": {
            "phase": "version",
            "prefix": "v"
          }
        }
      }
    }
  }
}
