{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "minimumReleaseAge": "3 days",
  "automerge": true,
  "rebaseWhen": "conflicted",
  "gitIgnoredAuthors": ["114827586+autofix-ci[bot]@users.noreply.github.com"],
  "assignees": ["kjanat"],
  "customManagers": [
    {
      "customType": "regex",
      "description": "GITLEAKS_VERSION passed to gitleaks-action",
      "managerFilePatterns": ["/^\\.github/workflows(-pending)?/[^/]+\\.ya?ml$/"],
      "matchStrings": ["GITLEAKS_VERSION:\\s*\"?(?<currentValue>\\d+\\.\\d+\\.\\d+)\"?"],
      "depNameTemplate": "gitleaks",
      "packageNameTemplate": "gitleaks/gitleaks",
      "datasourceTemplate": "github-releases",
      "extractVersionTemplate": "^v(?<version>.+)$"
    }
  ],
  "packageRules": [
    {
      "groupName": "wrangler",
      "matchDepNames": ["wrangler"],
      "matchManagers": ["bun", "mise"]
    },
    {
      "groupName": "bun",
      "matchDepNames": ["bun", "@types/bun"],
      "matchManagers": ["bun", "mise"]
    },
    {
      "groupName": "gitleaks",
      "matchDepNames": ["gitleaks"],
      "matchManagers": ["custom.regex", "mise"]
    },
    {
      "groupName": "Go modules",
      "matchManagers": ["gomod"],
      "matchUpdateTypes": ["minor", "patch"],
      "matchPackageNames": ["!github.com/kjanat/go-git/v6"]
    },
    {
      "groupName": "eslint",
      "matchPackageNames": ["eslint", "typescript-eslint", "@typescript-eslint/**"]
    },
    {
      "matchUpdateTypes": ["major"],
      "automerge": false
    },
    {
      "matchPackageNames": ["typescript"],
      "matchManagers": ["bun"],
      "allowedVersions": "<7"
    }
  ]
}
