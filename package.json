{
  "name": "gpg-signing-service",
  "version": "1.2.0",
  "private": true,
  "description": "Git commit signing API, with GPG-compatible signatures",
  "license": "AGPL-3.0-only OR MIT",
  "type": "module",
  "imports": {
    "#gpg-signing-service": "./src/index.ts",
    "#*": "./src/*.ts",
    "#schemas": "./src/schemas/index.ts",
    "#types": "./src/types/index.ts"
  },
  "exports": {
    ".": {
      "default": "./src/index.ts"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "db:create": "wrangler d1 create gpg-signing-audit",
    "db:create:staging": "wrangler d1 create gpg-signing-audit-staging",
    "db:migrate": "wrangler d1 migrations apply AUDIT_DB --remote",
    "db:migrate:local": "wrangler d1 migrations apply AUDIT_DB --local",
    "db:migrate:staging": "wrangler d1 migrations apply AUDIT_DB --remote --env staging",
    "deploy": "wrangler deploy",
    "deploy:staging": "wrangler deploy --env staging",
    "preview": "wrangler versions upload",
    "dev": "wrangler dev",
    "dev:staging": "wrangler dev --env staging",
    "fmt": "dprint fmt",
    "format": "dprint fmt",
    "format:check": "dprint check",
    "generate:api": "run -s generate:oapigen generate:oapi",
    "generate:oapi": "cd client && go tool oapi-codegen -config oapi-codegen.yaml openapi.json",
    "generate:oapigen": "bun scripts/generate-openapi.ts",
    "generate-key": "bash scripts/generate-key.sh",
    "prepare": "sh ./scripts/cf.sh",
    "lefthook:install": "lefthook install",
    "kv:create": "wrangler kv namespace create JWKS_CACHE",
    "kv:create:staging": "wrangler kv namespace create JWKS_CACHE --env staging",
    "lint": "run -pk lint:eslint lint:biome",
    "lint:fix": "run -sK lint:eslint:fix lint:biome:fix",
    "lint:eslint": "eslint src/",
    "lint:eslint:fix": "eslint src/ --fix",
    "lint:biome": "biome check",
    "lint:biome:fix": "biome check --fix",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "typecheck": "run @typescript/native --noEmit",
    "typegen": "wrangler types >/dev/null"
  },
  "dependencies": {
    "@hono/swagger-ui": "0.6.1",
    "@hono/zod-openapi": "1.6.3",
    "@sentry/cloudflare": "10.73.0",
    "hono": "4.13.7",
    "jose": "6.2.12",
    "micro509": "0.14.0",
    "openpgp": "6.3.1",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "0.22.0",
    "@commitlint/cli": "21.2.2",
    "@commitlint/config-conventional": "21.2.2",
    "@eslint/js": "10.0.1",
    "@types/bun": "1.4.2",
    "@typescript-eslint/eslint-plugin": "8.70.0",
    "@typescript-eslint/parser": "8.70.0",
    "@typescript/native": "npm:typescript@^7",
    "@vitest/coverage-istanbul": "4.1.11",
    "@vitest/runner": "4.1.11",
    "@vitest/snapshot": "4.1.11",
    "dprint": "0.57.4",
    "eslint": "10.10.0",
    "jiti": "2.7.0",
    "typescript": "<7",
    "typescript-eslint": "8.70.0",
    "vitest": "^4.1.11",
    "wrangler": "4.129.1",
    "yaml": "2.9.0"
  },
  "overrides": {
    "typescript": {
      ".": "<7"
    }
  },
  "packageManager": "bun@1.4.2"
}
