{
  "$schema": "https://dprint.dev/schemas/v0.json",
  "lineWidth": 80,
  "useTabs": false,
  "indentWidth": 2,
  "newLineKind": "lf",
  "incremental": true,
  "shfmt": {
    "useTabs": true,
    "binaryNextLine": true,
    "switchCaseIndent": true
  },
  "markdown": {
    "ignoreDirective": "prettier-ignore",
    "ignoreFileDirective": "prettier-ignore-file",
    "ignoreStartDirective": "prettier-ignore-start",
    "ignoreEndDirective": "prettier-ignore-end"
  },
  "dockerfile": {},
  "biome": {
    "lineWidth": 120,
    "indentWidth": 2,
    "indentStyle": "tab",
    "json.indentStyle": "space"
  },
  "ruff": { "indentWidth": 4, "lineLength": 88, "preview": true },
  "jupyter": {},
  "malva": {},
  "markup": {
    "ignoreFileCommentDirective": "prettier-ignore-file",
    "ignoreCommentDirective": "prettier-ignore"
  },
  "yaml": {
    "indentBlockSequenceInMap": true,
    "flowMap.preferSingleLine": true,
    "printWidth": 300
  },
  "excludes": [
    "**/*-lock.json",
    "**/.keys",
    "**/.venv",
    "**/node_modules",
    "**/openapi.json",
    "**/worker-configuration.d.ts"
  ],
  "plugins": [
    "https://plugins.dprint.dev/kjanat/shfmt-1.1.1.wasm",
    "npm:@dprint/markdown@0.28.2",
    "npm:@dprint/dockerfile@0.7.0",
    "npm:@dprint/biome@0.15.2",
    "npm:@dprint/ruff@0.11.3",
    "npm:@dprint/jupyter@0.5.0",
    "npm:dprint-plugin-malva@0.16.0",
    "npm:dprint-plugin-markup@0.27.6",
    "npm:dprint-plugin-yaml@0.6.0",
    "npm:@dprint/prettier@0.70.0/plugin.json@97c0dccf54ed5b7343e7a3f6418e77bd80afcd2b74beed3a632689d47e392ddc",
    "https://plugins.dprint.dev/kjanat/tombi-0.1.1.wasm",
    "npm:@jakebailey/dprint-plugin-gofumpt@0.0.20"
  ]
}
