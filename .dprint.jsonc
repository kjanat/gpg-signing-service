{
  "$schema": "https://dprint.dev/schemas/v0.json",
  "lineWidth": 80,
  "useTabs": false,
  "indentWidth": 2,
  "newLineKind": "lf",
  "incremental": true,
  "shfmt": {
    "useTabs": true,
    "binaryNextLine": true,
    "switchCaseIndent": true
  },
  "markdown": {
    "ignoreDirective": "prettier-ignore",
    "ignoreFileDirective": "prettier-ignore-file",
    "ignoreStartDirective": "prettier-ignore-start",
    "ignoreEndDirective": "prettier-ignore-end"
  },
  "dockerfile": {},
  "biome": {
    "lineWidth": 120,
    "indentWidth": 2,
    "indentStyle": "tab",
    "json.indentStyle": "space"
  },
  "ruff": { "indentWidth": 4, "lineLength": 88, "preview": true },
  "jupyter": {},
  "malva": {},
  "markup": {
    "ignoreFileCommentDirective": "prettier-ignore-file",
    "ignoreCommentDirective": "prettier-ignore"
  },
  "yaml": {
    "indentBlockSequenceInMap": true,
    "flowMap.preferSingleLine": true,
    "printWidth": 300
  },
  "exec": {
    "cwd": "${configDir}",
    "commands": [
      {
        "cwd": "${configDir}/client",
        "command": "golangci-lint fmt --color never --stdin {{file_path}}",
        "exts": ["go"],
        "stdin": true,
        "cacheKeyFiles": ["../.golangci.yml", "../.mise.toml"],
        "setupCommand": "mise install golangci-lint"
      },
      {
        "command": "tombi format - --stdin-filename {{file_path}}",
        "exts": ["toml"],
        "cacheKeyFiles": ["tombi.toml", ".mise.toml"],
        "setupCommand": "mise install tombi"
      }
    ]
  },
  "excludes": [
    "**/*-lock.json",
    "**/.keys",
    "**/.venv",
    "**/node_modules",
    "**/openapi.json",
    "**/worker-configuration.d.ts"
  ],
  "plugins": [
    "https://plugins.dprint.dev/kjanat/shfmt-1.1.0.wasm",
    "npm:@dprint/markdown@0.23.3",
    "npm:@dprint/dockerfile@0.6.0",
    "npm:@dprint/biome@0.13.11",
    "npm:@dprint/ruff@0.8.6",
    "npm:@dprint/jupyter@0.3.1",
    "npm:dprint-plugin-malva@0.16.0",
    "npm:dprint-plugin-markup@0.27.3",
    "npm:dprint-plugin-yaml@0.6.0",
    "npm:@dprint/exec@0.7.3/plugin.json@704701df449dd7e942a71144773778ac529d68c2e4657bfc236d393b898b9a67",
    "npm:@dprint/prettier@0.70.0/plugin.json@97c0dccf54ed5b7343e7a3f6418e77bd80afcd2b74beed3a632689d47e392ddc"
  ]
}
